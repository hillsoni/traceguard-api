# .env.example — Reference template for environment variables.
#
# Copy this file to .env and fill in real values before running locally.
# NEVER commit .env to version control.
#
# In production, inject secrets via your platform's secret manager
# (AWS Secrets Manager, GCP Secret Manager, Vault, etc.).

# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32
PORT=5000
APP_NAME=TraceGuard API

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flask_logging
DB_USER=postgres
DB_PASSWORD=change-me-strong-password
DB_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_DB_NAME=flaskdb
MONGO_URI=mongodb://localhost:27017/${MONGO_DB_NAME}

# ── Redis (rate limiting) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-with-python-secrets-token-hex-32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Gunicorn (production) ─────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_THREADS=4